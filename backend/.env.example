# Replace both placeholders before adding these values to the Render backend service.
# Copy the Postgres URI from Supabase Dashboard > Connect; use a connection method
# supported by your Render service and keep this credential on the backend only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres?sslmode=require
FRONTEND_ORIGIN=https://your-frontend.vercel.app
