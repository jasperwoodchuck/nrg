# For Supabase on Render, copy the Session pooler URI from Supabase Dashboard > Connect.
# It supports IPv4-only hosts. Keep this credential in the backend environment only.
# For Render Postgres, use its Internal Database URL when the web service is in the same region.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
FRONTEND_ORIGIN=https://your-frontend.vercel.app
